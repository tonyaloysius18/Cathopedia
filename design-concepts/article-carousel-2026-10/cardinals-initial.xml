ckable="false" password="false" selected="false" bounds="[1000,1398][1144,1542]" drawing-order="2" hint="" /></node><node index="10" text="" resource-id="" class="android.view.View" package="com.ynotlabs.cathopedia" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[60,1578][1220,2334]" drawing-order="10" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.ynotlabs.cathopedia" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,1875][120,2037]" drawing-order="0" hint="" /><node index="1" text="Dean of the College of Cardinals" resource-id="" class="android.widget.TextView" package="com.ynotlabs.cathopedia" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,1626][1034,1697]" drawing-order="1" hint="" /><node index="2" text="The first among equals in the College. He is elected by the cardinal bishops from among themselves and confirmed by the Pope, now for a five-year term that may be renewed, and he adds the title of the see of Ostia to his own (canons 350 &#167;4, 352). When the see of Peter falls vacant he summons the cardinals and presides over their meetings and, if he is under eighty, over the conclave, where he asks the one elected whether he accepts and what name he will take." resource-id="" class="android.widget.TextView" package="com.ynotlabs.cathopedia" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[120,1721][1160,2274]" 