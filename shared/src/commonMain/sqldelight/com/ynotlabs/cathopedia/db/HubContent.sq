-- Topic hub storage. Structure is normalized; every piece of human-readable text
-- is indirected through localized_text so adding a language never touches these rows.
--
-- Blocks, hotspots, steps and events keep their payload as JSON in a `payload` column:
-- they are always read as a whole list for one parent and never queried by field, so
-- normalizing them further would buy nothing and cost a dozen joins.

CREATE TABLE topic_hub (
    id             TEXT NOT NULL PRIMARY KEY,
    slug           TEXT NOT NULL UNIQUE,
    title_key      TEXT NOT NULL,
    subtitle_key   TEXT,
    intro_key      TEXT,
    icon           TEXT,
    hero_asset     TEXT,
    accent_color   TEXT,
    sort_order     INTEGER NOT NULL,
    content_version INTEGER NOT NULL
);

CREATE TABLE hub_section (
    id            TEXT NOT NULL PRIMARY KEY,
    hub_id        TEXT NOT NULL,
    sort_order    INTEGER NOT NULL,
    status        TEXT NOT NULL,       -- PUBLISHED | STUB
    layout        TEXT NOT NULL,       -- ARTICLES | DIAGRAM | STEPPER | TIMELINE | FACT_SHEET | COLLECTION
    title_key     TEXT NOT NULL,
    summary_key   TEXT,
    icon          TEXT,
    hero_asset    TEXT,
    accent_color  TEXT,
    fact_sheet_id TEXT,
    stepper_id    TEXT,
    timeline_id   TEXT,
    collection_query TEXT,             -- JSON, null unless layout = COLLECTION
    diagram_id    TEXT,                -- first entry of Section.diagramIds; every DIAGRAM section in
                                        -- the content so far carries exactly one, see content/hubs/holy_see.json
    FOREIGN KEY (hub_id) REFERENCES topic_hub(id) ON DELETE CASCADE
);
CREATE INDEX hub_section_hub_idx ON hub_section(hub_id, sort_order);

CREATE TABLE hub_article (
    id             TEXT NOT NULL PRIMARY KEY,
    section_id     TEXT NOT NULL,
    sort_order     INTEGER NOT NULL,
    title_key      TEXT NOT NULL,
    lead_key       TEXT,
    hero_asset     TEXT,
    reading_time   INTEGER,
    blocks_json    TEXT NOT NULL,
    related_json   TEXT NOT NULL DEFAULT '[]',
    sources_json   TEXT NOT NULL DEFAULT '[]',
    FOREIGN KEY (section_id) REFERENCES hub_section(id) ON DELETE CASCADE
);
CREATE INDEX hub_article_section_idx ON hub_article(section_id, sort_order);

CREATE TABLE hub_fact_sheet (
    id         TEXT NOT NULL PRIMARY KEY,
    hub_id     TEXT NOT NULL,
    title_key  TEXT NOT NULL,
    facts_json TEXT NOT NULL,
    FOREIGN KEY (hub_id) REFERENCES topic_hub(id) ON DELETE CASCADE
);

CREATE TABLE hub_diagram (
    id            TEXT NOT NULL PRIMARY KEY,
    hub_id        TEXT NOT NULL,
    title_key     TEXT,
    caption_key   TEXT,
    asset         TEXT NOT NULL,
    aspect_ratio  REAL NOT NULL,
    min_zoom      REAL NOT NULL DEFAULT 1.0,
    max_zoom      REAL NOT NULL DEFAULT 5.0,
    focus_x       REAL,
    focus_y       REAL,
    FOREIGN KEY (hub_id) REFERENCES topic_hub(id) ON DELETE CASCADE
);

-- Hotspots stay relational: the section screen queries them by diagram, and a future
-- search feature will want to find "which diagram shows the Creation of Adam".
CREATE TABLE hub_hotspot (
    id           TEXT NOT NULL PRIMARY KEY,
    diagram_id   TEXT NOT NULL,
    label_key    TEXT NOT NULL,
    blurb_key    TEXT,
    tour_order   INTEGER,
    shape_json   TEXT NOT NULL,        -- {"type":"rect"|"circle"|"polygon", ...} normalized 0..1
    target_type  TEXT,
    target_id    TEXT,
    FOREIGN KEY (diagram_id) REFERENCES hub_diagram(id) ON DELETE CASCADE
);
CREATE INDEX hub_hotspot_diagram_idx ON hub_hotspot(diagram_id, tour_order);
CREATE INDEX hub_hotspot_target_idx ON hub_hotspot(target_type, target_id);

CREATE TABLE hub_stepper (
    id         TEXT NOT NULL PRIMARY KEY,
    hub_id     TEXT NOT NULL,
    title_key  TEXT NOT NULL,
    intro_key  TEXT,
    steps_json TEXT NOT NULL,
    FOREIGN KEY (hub_id) REFERENCES topic_hub(id) ON DELETE CASCADE
);

CREATE TABLE hub_timeline (
    id          TEXT NOT NULL PRIMARY KEY,
    hub_id      TEXT NOT NULL,
    title_key   TEXT NOT NULL,
    events_json TEXT NOT NULL,
    FOREIGN KEY (hub_id) REFERENCES topic_hub(id) ON DELETE CASCADE
);

-- Shared with the rest of the app (popes, saints, prayers): one table, every language.
CREATE TABLE localized_text (
    key   TEXT NOT NULL,
    lang  TEXT NOT NULL,
    value TEXT NOT NULL,
    PRIMARY KEY (key, lang)
);
CREATE INDEX localized_text_lang_idx ON localized_text(lang);

-- ---------------------------------------------------------------- queries

selectHub:
SELECT * FROM topic_hub WHERE id = :id;

selectHubsOrdered:
SELECT * FROM topic_hub ORDER BY sort_order;

selectSections:
SELECT * FROM hub_section WHERE hub_id = :hubId ORDER BY sort_order;

selectArticlesForSection:
SELECT * FROM hub_article WHERE section_id = :sectionId ORDER BY sort_order;

selectArticle:
SELECT * FROM hub_article WHERE id = :id;

selectDiagram:
SELECT * FROM hub_diagram WHERE id = :id;

selectHotspots:
SELECT * FROM hub_hotspot WHERE diagram_id = :diagramId ORDER BY tour_order, id;

selectFactSheet:
SELECT * FROM hub_fact_sheet WHERE id = :id;

selectStepper:
SELECT * FROM hub_stepper WHERE id = :id;

selectTimeline:
SELECT * FROM hub_timeline WHERE id = :id;

-- Resolve a batch of keys for the active language, falling back to the default language
-- per key so a PARTIAL translation degrades key-by-key instead of screen-by-screen.
selectStrings:
SELECT key, COALESCE(
    (SELECT value FROM localized_text t WHERE t.key = base.key AND t.lang = :lang),
    (SELECT value FROM localized_text f WHERE f.key = base.key AND f.lang = :fallbackLang)
) AS value
FROM (SELECT DISTINCT key FROM localized_text WHERE key IN :keys) AS base;

contentVersionForHub:
SELECT content_version FROM topic_hub WHERE id = :id;

insertHub:
INSERT OR REPLACE INTO topic_hub VALUES ?;

insertSection:
INSERT OR REPLACE INTO hub_section VALUES ?;

insertArticle:
INSERT OR REPLACE INTO hub_article VALUES ?;

insertFactSheet:
INSERT OR REPLACE INTO hub_fact_sheet VALUES ?;

insertDiagram:
INSERT OR REPLACE INTO hub_diagram VALUES ?;

insertHotspot:
INSERT OR REPLACE INTO hub_hotspot VALUES ?;

insertStepper:
INSERT OR REPLACE INTO hub_stepper VALUES ?;

insertTimeline:
INSERT OR REPLACE INTO hub_timeline VALUES ?;

insertString:
INSERT OR REPLACE INTO localized_text VALUES ?;

deleteHubCascade:
DELETE FROM topic_hub WHERE id = :id;
