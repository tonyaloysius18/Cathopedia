CREATE TABLE ChurchEntity (
    id TEXT NOT NULL PRIMARY KEY,
    latitude REAL,
    longitude REAL,
    foundedYear INTEGER,
    imageUrl TEXT,
    sourceUrl TEXT
);

CREATE TABLE ChurchText (
    churchId TEXT NOT NULL,
    language TEXT NOT NULL,
    name TEXT NOT NULL,
    summary TEXT NOT NULL,
    body TEXT NOT NULL,
    sourceAttribution TEXT,
    PRIMARY KEY (churchId, language),
    FOREIGN KEY (churchId) REFERENCES ChurchEntity(id) ON DELETE CASCADE
);

insertChurch:
INSERT OR REPLACE INTO ChurchEntity(id, latitude, longitude, foundedYear, imageUrl, sourceUrl)
VALUES (?, ?, ?, ?, ?, ?);

insertChurchText:
INSERT OR REPLACE INTO ChurchText(churchId, language, name, summary, body, sourceAttribution)
VALUES (?, ?, ?, ?, ?, ?);

-- Counting rows for the Explore tiles: cheaper than materialising every
-- summary just to take the size of the list.
--
-- Reads via two LEFT JOINs (the requested language, then :fallbackLang) with
-- COALESCE over the two, rather than a single INNER JOIN — so a church with
-- no row yet in a newly added language still shows English text instead of
-- vanishing from lists and detail lookups.
countChurches:
SELECT COUNT(*) FROM ChurchEntity
LEFT JOIN ChurchText t ON t.churchId = ChurchEntity.id AND t.language = :language
LEFT JOIN ChurchText f ON f.churchId = ChurchEntity.id AND f.language = :fallbackLang
WHERE t.churchId IS NOT NULL OR f.churchId IS NOT NULL;

selectAllChurches:
SELECT ChurchEntity.id AS id, COALESCE(t.name, f.name) AS name, COALESCE(t.summary, f.summary) AS summary,
       ChurchEntity.imageUrl AS imageUrl
FROM ChurchEntity
LEFT JOIN ChurchText t ON t.churchId = ChurchEntity.id AND t.language = :language
LEFT JOIN ChurchText f ON f.churchId = ChurchEntity.id AND f.language = :fallbackLang
WHERE t.churchId IS NOT NULL OR f.churchId IS NOT NULL
ORDER BY COALESCE(t.name, f.name) ASC;

selectChurchDetail:
SELECT ChurchEntity.id AS id, COALESCE(t.name, f.name) AS name, COALESCE(t.summary, f.summary) AS summary,
       COALESCE(t.body, f.body) AS body,
       ChurchEntity.latitude AS latitude, ChurchEntity.longitude AS longitude,
       ChurchEntity.foundedYear AS foundedYear, ChurchEntity.imageUrl AS imageUrl,
       ChurchEntity.sourceUrl AS sourceUrl, COALESCE(t.sourceAttribution, f.sourceAttribution) AS sourceAttribution
FROM ChurchEntity
LEFT JOIN ChurchText t ON t.churchId = ChurchEntity.id AND t.language = :language
LEFT JOIN ChurchText f ON f.churchId = ChurchEntity.id AND f.language = :fallbackLang
WHERE ChurchEntity.id = :id AND (t.churchId IS NOT NULL OR f.churchId IS NOT NULL);
