CREATE TABLE ApparitionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    location TEXT,
    apparitionYear INTEGER,
    approvalStatus TEXT,
    imageUrl TEXT,
    sourceUrl TEXT
);

CREATE TABLE ApparitionText (
    apparitionId TEXT NOT NULL,
    language TEXT NOT NULL,
    name TEXT NOT NULL,
    summary TEXT NOT NULL,
    body TEXT NOT NULL,
    sourceAttribution TEXT,
    PRIMARY KEY (apparitionId, language),
    FOREIGN KEY (apparitionId) REFERENCES ApparitionEntity(id) ON DELETE CASCADE
);

insertApparition:
INSERT OR REPLACE INTO ApparitionEntity(id, location, apparitionYear, approvalStatus, imageUrl, sourceUrl)
VALUES (?, ?, ?, ?, ?, ?);

insertApparitionText:
INSERT OR REPLACE INTO ApparitionText(apparitionId, language, name, summary, body, sourceAttribution)
VALUES (?, ?, ?, ?, ?, ?);

-- Counting rows for the Explore tiles: cheaper than materialising every
-- summary just to take the size of the list.
--
-- Reads via two LEFT JOINs (the requested language, then :fallbackLang) with
-- COALESCE over the two, rather than a single INNER JOIN — so an apparition
-- with no row yet in a newly added language still shows English text instead
-- of vanishing from lists and detail lookups.
countApparitions:
SELECT COUNT(*) FROM ApparitionEntity
LEFT JOIN ApparitionText t ON t.apparitionId = ApparitionEntity.id AND t.language = :language
LEFT JOIN ApparitionText f ON f.apparitionId = ApparitionEntity.id AND f.language = :fallbackLang
WHERE t.apparitionId IS NOT NULL OR f.apparitionId IS NOT NULL;

selectAllApparitions:
SELECT ApparitionEntity.id AS id, COALESCE(t.name, f.name) AS name, COALESCE(t.summary, f.summary) AS summary,
       ApparitionEntity.imageUrl AS imageUrl
FROM ApparitionEntity
LEFT JOIN ApparitionText t ON t.apparitionId = ApparitionEntity.id AND t.language = :language
LEFT JOIN ApparitionText f ON f.apparitionId = ApparitionEntity.id AND f.language = :fallbackLang
WHERE t.apparitionId IS NOT NULL OR f.apparitionId IS NOT NULL
ORDER BY ApparitionEntity.apparitionYear ASC;

selectApparitionDetail:
SELECT ApparitionEntity.id AS id, COALESCE(t.name, f.name) AS name, COALESCE(t.summary, f.summary) AS summary,
       COALESCE(t.body, f.body) AS body, ApparitionEntity.location AS location,
       ApparitionEntity.apparitionYear AS apparitionYear, ApparitionEntity.approvalStatus AS approvalStatus,
       ApparitionEntity.imageUrl AS imageUrl, ApparitionEntity.sourceUrl AS sourceUrl,
       COALESCE(t.sourceAttribution, f.sourceAttribution) AS sourceAttribution
FROM ApparitionEntity
LEFT JOIN ApparitionText t ON t.apparitionId = ApparitionEntity.id AND t.language = :language
LEFT JOIN ApparitionText f ON f.apparitionId = ApparitionEntity.id AND f.language = :fallbackLang
WHERE ApparitionEntity.id = :id AND (t.apparitionId IS NOT NULL OR f.apparitionId IS NOT NULL);
