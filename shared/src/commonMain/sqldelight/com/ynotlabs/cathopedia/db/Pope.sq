CREATE TABLE PopeEntity (
    id TEXT NOT NULL PRIMARY KEY,
    regnalNumber INTEGER,
    papacyStart TEXT,
    papacyEnd TEXT,
    -- Numeric year parsed from papacyStart (handles "c. 64", "988-01-01", "1003-06",
    -- etc.) so chronological ordering doesn't fall prey to text sorting on mixed-
    -- precision date strings. papacyStart/papacyEnd stay untouched for display.
    papacyStartYear INTEGER,
    imageUrl TEXT,
    sourceUrl TEXT
);

CREATE TABLE PopeText (
    popeId TEXT NOT NULL,
    language TEXT NOT NULL,
    name TEXT NOT NULL,
    summary TEXT NOT NULL,
    body TEXT NOT NULL,
    sourceAttribution TEXT,
    PRIMARY KEY (popeId, language),
    FOREIGN KEY (popeId) REFERENCES PopeEntity(id) ON DELETE CASCADE
);

insertPope:
INSERT OR REPLACE INTO PopeEntity(id, regnalNumber, papacyStart, papacyEnd, papacyStartYear, imageUrl, sourceUrl)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertPopeText:
INSERT OR REPLACE INTO PopeText(popeId, language, name, summary, body, sourceAttribution)
VALUES (?, ?, ?, ?, ?, ?);

-- Counting rows for the Explore tiles: cheaper than materialising every
-- summary just to take the size of the list.
--
-- Reads via two LEFT JOINs (the requested language, then :fallbackLang) with
-- COALESCE over the two, rather than a single INNER JOIN — so a pope with no
-- row yet in a newly added language still shows English text instead of
-- vanishing from lists and detail lookups.
countPopes:
SELECT COUNT(*) FROM PopeEntity
LEFT JOIN PopeText t ON t.popeId = PopeEntity.id AND t.language = :language
LEFT JOIN PopeText f ON f.popeId = PopeEntity.id AND f.language = :fallbackLang
WHERE t.popeId IS NOT NULL OR f.popeId IS NOT NULL;

selectAllPopes:
SELECT PopeEntity.id AS id, COALESCE(t.name, f.name) AS name, COALESCE(t.summary, f.summary) AS summary,
       PopeEntity.papacyStart AS papacyStart, PopeEntity.papacyEnd AS papacyEnd, PopeEntity.imageUrl AS imageUrl,
       PopeEntity.papacyStartYear AS papacyStartYear
FROM PopeEntity
LEFT JOIN PopeText t ON t.popeId = PopeEntity.id AND t.language = :language
LEFT JOIN PopeText f ON f.popeId = PopeEntity.id AND f.language = :fallbackLang
WHERE t.popeId IS NOT NULL OR f.popeId IS NOT NULL
ORDER BY PopeEntity.papacyStartYear ASC;

selectPopeDetail:
SELECT PopeEntity.id AS id, COALESCE(t.name, f.name) AS name, COALESCE(t.summary, f.summary) AS summary,
       COALESCE(t.body, f.body) AS body,
       PopeEntity.regnalNumber AS regnalNumber, PopeEntity.papacyStart AS papacyStart,
       PopeEntity.papacyEnd AS papacyEnd, PopeEntity.imageUrl AS imageUrl, PopeEntity.sourceUrl AS sourceUrl,
       COALESCE(t.sourceAttribution, f.sourceAttribution) AS sourceAttribution
FROM PopeEntity
LEFT JOIN PopeText t ON t.popeId = PopeEntity.id AND t.language = :language
LEFT JOIN PopeText f ON f.popeId = PopeEntity.id AND f.language = :fallbackLang
WHERE PopeEntity.id = :id AND (t.popeId IS NOT NULL OR f.popeId IS NOT NULL);
