CREATE TABLE MiracleEntity (
    id TEXT NOT NULL PRIMARY KEY,
    location TEXT,
    miracleYear INTEGER,
    imageUrl TEXT,
    sourceUrl TEXT
);

CREATE TABLE MiracleText (
    miracleId TEXT NOT NULL,
    language TEXT NOT NULL,
    name TEXT NOT NULL,
    summary TEXT NOT NULL,
    body TEXT NOT NULL,
    sourceAttribution TEXT,
    PRIMARY KEY (miracleId, language),
    FOREIGN KEY (miracleId) REFERENCES MiracleEntity(id) ON DELETE CASCADE
);

insertMiracle:
INSERT OR REPLACE INTO MiracleEntity(id, location, miracleYear, imageUrl, sourceUrl)
VALUES (?, ?, ?, ?, ?);

insertMiracleText:
INSERT OR REPLACE INTO MiracleText(miracleId, language, name, summary, body, sourceAttribution)
VALUES (?, ?, ?, ?, ?, ?);

-- Counting rows for the Explore tiles: cheaper than materialising every
-- summary just to take the size of the list.
--
-- Reads via two LEFT JOINs (the requested language, then :fallbackLang) with
-- COALESCE over the two, rather than a single INNER JOIN — so a miracle with
-- no row yet in a newly added language still shows English text instead of
-- vanishing from lists and detail lookups.
countMiracles:
SELECT COUNT(*) FROM MiracleEntity
LEFT JOIN MiracleText t ON t.miracleId = MiracleEntity.id AND t.language = :language
LEFT JOIN MiracleText f ON f.miracleId = MiracleEntity.id AND f.language = :fallbackLang
WHERE t.miracleId IS NOT NULL OR f.miracleId IS NOT NULL;

selectAllMiracles:
SELECT MiracleEntity.id AS id, COALESCE(t.name, f.name) AS name, COALESCE(t.summary, f.summary) AS summary,
       MiracleEntity.imageUrl AS imageUrl
FROM MiracleEntity
LEFT JOIN MiracleText t ON t.miracleId = MiracleEntity.id AND t.language = :language
LEFT JOIN MiracleText f ON f.miracleId = MiracleEntity.id AND f.language = :fallbackLang
WHERE t.miracleId IS NOT NULL OR f.miracleId IS NOT NULL
ORDER BY MiracleEntity.miracleYear ASC;

selectMiracleDetail:
SELECT MiracleEntity.id AS id, COALESCE(t.name, f.name) AS name, COALESCE(t.summary, f.summary) AS summary,
       COALESCE(t.body, f.body) AS body,
       MiracleEntity.location AS location, MiracleEntity.miracleYear AS miracleYear,
       MiracleEntity.imageUrl AS imageUrl, MiracleEntity.sourceUrl AS sourceUrl,
       COALESCE(t.sourceAttribution, f.sourceAttribution) AS sourceAttribution
FROM MiracleEntity
LEFT JOIN MiracleText t ON t.miracleId = MiracleEntity.id AND t.language = :language
LEFT JOIN MiracleText f ON f.miracleId = MiracleEntity.id AND f.language = :fallbackLang
WHERE MiracleEntity.id = :id AND (t.miracleId IS NOT NULL OR f.miracleId IS NOT NULL);
