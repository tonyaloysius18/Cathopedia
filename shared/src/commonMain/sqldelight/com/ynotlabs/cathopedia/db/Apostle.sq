CREATE TABLE ApostleEntity (
    id TEXT NOT NULL PRIMARY KEY,
    originalName TEXT,
    martyrdom TEXT,
    imageUrl TEXT,
    sourceUrl TEXT
);

CREATE TABLE ApostleText (
    apostleId TEXT NOT NULL,
    language TEXT NOT NULL,
    name TEXT NOT NULL,
    summary TEXT NOT NULL,
    body TEXT NOT NULL,
    sourceAttribution TEXT,
    PRIMARY KEY (apostleId, language),
    FOREIGN KEY (apostleId) REFERENCES ApostleEntity(id) ON DELETE CASCADE
);

insertApostle:
INSERT OR REPLACE INTO ApostleEntity(id, originalName, martyrdom, imageUrl, sourceUrl)
VALUES (?, ?, ?, ?, ?);

insertApostleText:
INSERT OR REPLACE INTO ApostleText(apostleId, language, name, summary, body, sourceAttribution)
VALUES (?, ?, ?, ?, ?, ?);

-- Counting rows for the Explore tiles: cheaper than materialising every
-- summary just to take the size of the list.
--
-- Reads via two LEFT JOINs (the requested language, then :fallbackLang) with
-- COALESCE over the two, rather than a single INNER JOIN — so an apostle with
-- no row yet in a newly added language still shows English text instead of
-- vanishing from lists and detail lookups.
countApostles:
SELECT COUNT(*) FROM ApostleEntity
LEFT JOIN ApostleText t ON t.apostleId = ApostleEntity.id AND t.language = :language
LEFT JOIN ApostleText f ON f.apostleId = ApostleEntity.id AND f.language = :fallbackLang
WHERE t.apostleId IS NOT NULL OR f.apostleId IS NOT NULL;

selectAllApostles:
SELECT ApostleEntity.id AS id, COALESCE(t.name, f.name) AS name, COALESCE(t.summary, f.summary) AS summary,
       ApostleEntity.imageUrl AS imageUrl
FROM ApostleEntity
LEFT JOIN ApostleText t ON t.apostleId = ApostleEntity.id AND t.language = :language
LEFT JOIN ApostleText f ON f.apostleId = ApostleEntity.id AND f.language = :fallbackLang
WHERE t.apostleId IS NOT NULL OR f.apostleId IS NOT NULL
ORDER BY COALESCE(t.name, f.name) ASC;

selectApostleDetail:
SELECT ApostleEntity.id AS id, COALESCE(t.name, f.name) AS name, COALESCE(t.summary, f.summary) AS summary,
       COALESCE(t.body, f.body) AS body,
       ApostleEntity.originalName AS originalName, ApostleEntity.martyrdom AS martyrdom,
       ApostleEntity.imageUrl AS imageUrl, ApostleEntity.sourceUrl AS sourceUrl,
       COALESCE(t.sourceAttribution, f.sourceAttribution) AS sourceAttribution
FROM ApostleEntity
LEFT JOIN ApostleText t ON t.apostleId = ApostleEntity.id AND t.language = :language
LEFT JOIN ApostleText f ON f.apostleId = ApostleEntity.id AND f.language = :fallbackLang
WHERE ApostleEntity.id = :id AND (t.apostleId IS NOT NULL OR f.apostleId IS NOT NULL);
