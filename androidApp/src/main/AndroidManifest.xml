<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Cathopedia"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Cathopedia">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.ynotlabs.cathopedia.notifications.FeastNotificationReceiver"
            android:exported="false" />

        <!-- BOOT_COMPLETED/MY_PACKAGE_REPLACED are protected system broadcasts — only
             the OS can send them, so exported="true" here doesn't open this up to
             other apps despite the flag; it's required for the system to deliver an
             implicit broadcast into this receiver at all. Re-arms the AlarmManager
             alarms FeastNotificationScheduler scheduled, which reboots (and app
             updates) otherwise silently clear. -->
        <receiver
            android:name="com.ynotlabs.cathopedia.notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
